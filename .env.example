# Copy this file to .env and fill in real values. NEVER commit .env.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (Atlas -> Database -> Connect -> Drivers)
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/servicehub?retryWrites=true&w=majority
MONGODB_URI=

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

BCRYPT_SALT_ROUNDS=10

# Comma-separated allowed origins for the Flutter Web app ("*" = allow all, dev only)
CORS_ORIGINS=*

# Used only by `npm run seed:admin` to create the first admin account
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional, tests only: reuse a locally installed mongod instead of downloading one.
# Windows example: MONGOMS_SYSTEM_BINARY=C:/Program Files/MongoDB/Server/8.3/bin/mongod.exe
MONGOMS_SYSTEM_BINARY=
